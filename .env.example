# Copie para .env (local) ou configure no painel da Render.
PORT=3000
MAX_PAGES=300                 # páginas por loja
CACHE_TTL_MINUTES=30          # tempo mínimo entre raspagens
RETRY_AFTER_FAIL_MINUTES=5    # espera antes de tentar de novo após falha
DATA_DIR=./data               # na Render com disco persistente: /var/data
API_KEY=troque-por-um-segredo # exigida em POST /api/refresh (sem ela o endpoint fica desativado)
CORS_ORIGINS=*                # ou lista separada por vírgula
WARM_ON_START=false           # true = raspa já ao iniciar, sem esperar a 1ª chamada
IG_COOKIE=                    # opcional: cookie enviado ao Instant Gaming (ex.: para fixar moeda/região)
IG_CONCURRENCY=5
IG_GAP_MS=120
NV_CONCURRENCY=2
NV_GAP_MS=700
# Afiliados (valores padrão = os da extensão)
AFF_IG=citario
AFF_NV_ID=c/wenaA4Ols
AFF_NV_MID=46796
AFF_NV_U1=citario
